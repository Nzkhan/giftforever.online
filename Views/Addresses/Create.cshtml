@model Baganova.Models.Address

@{
    ViewBag.Title = "Add Address";
    Layout = "~/Views/Shared/_LayoutLogged.cshtml";
}

<section class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/home" style="color:white">Home</a> <span class="mx-2 mb-0">></span> <span>Profile</span>  <span class="mx-2 mb-0">></span> <span>Add Address</span></div>
        </div>
    </div>
</section>

<section class="site-section">
    <div class="container">
        <div class="row justify-content-center py-4">
            <div class="col-lg-8">
                <div class="p-4 p-lg-5">
                    <div class="d-flex align-items-center mb-3">
                        <h3 class="mb-0" style="font-weight:700">Add Address</h3>
                        <div style="flex:1 1 auto"></div>
                        @Html.ActionLink("Back to Addresses", "Index", null, new { @class = "site-btn", style = "padding:8px 12px;border-radius:6px;" })
                    </div>

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.address, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.address, new { @class = "form-control", rows = 5, style = "min-height:120px;" })
                            @Html.ValidationMessageFor(m => m.address, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex justify-content-end">
                            <input type="submit" value="Create" class="site-btn" style="padding:8px 16px;border-radius:6px;" />
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Flat, sleek styles for address create form */
    .form-label { font-weight:700; }
    .form-control { border:1px solid #eef0f2; border-radius:6px; }
    .site-btn { background:#111; color:#fff; }
    @@media (max-width:576px) { .site-btn { padding:8px 10px; } }
</style>
