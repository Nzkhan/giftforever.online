@model Baganova.Models.Address

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutLogged.cshtml";
}

<style>
    .field-css {
        padding: 15px 10px;
        font-size: 16px;
        font-weight: 500;
        width: 100%;
        border-radius: 5px;
        border: 1px solid #d5cdcd;
    }
</style>


<br />
<br />
<br />


<div class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="~/Shopper.csproj" style="color:white">Home</a> <span class="mx-2 mb-0">></span> <span>Profile</span>  <span class="mx-2 mb-0">></span> <span>Edit Address</span></div>
        </div>
    </div>
</div>


<div class="site-section">
    <div class="container">
        <div class="row py-4">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="p-3 p-lg-5  shadow" style="border-radius:12px">

                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            <p class="text-black" style=" font-weight: 600; text-align: center; font-size: 24px; color: black;">Edit Address</p>
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.ID)
                            <div class="form-group">
                                <div class="col-md-12">
                                    @*@Html.EditorFor(model => model.address, new { htmlAttributes = new { @class = "form-control" } })*@
                                    @Html.TextAreaFor(model => model.address, new { @class = "field-css", rows = 5 })

                                    @Html.ValidationMessageFor(model => model.address, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Save" class="createbtn mr-3" />
                                    @Html.ActionLink("Back to List", "Index", new { id = TempData.Peek("addId").ToString() }, new { @class = "backtolistbtn" })
                                  
                                    @* @Html.ActionLink("Back to List", "Index", new { id = Model.ID }, new { @class = "backtolistbtn" })*@
                                </div>
                            </div>
                        </div>
                    }
                  
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
</div>

