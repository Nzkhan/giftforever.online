@model Baganova.Models.Blog

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .tag {
        background-color: #f2f2f2;
        border-radius: 10px;
        padding: 5px 20px 5px 10px;
        margin: 5px;
        display: inline-block;
        position: relative;
        font-size: 16px;
        color: black;
        font-weight: 600;
    }

    .closeBtn {
        position: absolute;
        top: 0px;
        right: 2px;
        cursor: pointer;
        font-size: 22px;
        color: red;
    }
</style>
<div class="custom-border-bottom py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/Products/Index">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Create Blogs</strong></div>
        </div>
    </div>
</div>
<div class="site-section" style="margin-top:-30px">
    <div class="container">
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="p-3 p-lg-5 border">
                    @using (Html.BeginForm("Create", "Blogs", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            <h4>Blog</h4>
                            <hr />
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group">
                                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.Description, new { rows = "8", cols = "10", @class = "form-control" })
                                    @*@Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })*@
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Photo, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    <label class="file">
                                        <input type="file" id="Photo1" name="Photo" aria-label="File Browser Example" />
                                        <span class="file-custom"></span>
                                    </label>
                                    <img loading="lazy" id="Photo1PreviewPhoto" alt="No Image Uploaded" name="Photo8PreviewPhoto" style="max-width: 100%; height: 200px;" />
                                </div>
                            </div>


                            <div class="form-group">
                                <label for="Tags" class="ml-3">Tags:</label>
                                <div class="col-md-10">
                                    <input type="text" id="tagInput" class="form-control" placeholder="Enter tag here" />
                                    <div id="tagContainer"></div>
                                    <input type="hidden" id="tagsInput" name="tags" />
                                </div>
                            </div>



                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Create" class="btn btn-success" />
                                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-info", @style = "padding-top:12px" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
</div>
<script>
    let tagInput = document.getElementById("tagInput");
    let tagContainer = document.getElementById("tagContainer");
    let tagsInput = document.getElementById("tagsInput");
    let tags = [];
    let maxTags = 1000;

    tagInput.addEventListener("keydown", function (event) {
        if (event.key === "Enter" && tagInput.value.length > 0) {
            if (tags.length < maxTags) {
                let newTag = document.createElement("div");
                newTag.classList.add("tag");
                newTag.innerHTML = tagInput.value +
                    '<span class="closeBtn">&times;</span>';
                tagContainer.appendChild(newTag);
                tags.push(tagInput.value);
                tagInput.value = "";
                tagsInput.value = tags.join(",");

                newTag.querySelector(".closeBtn").addEventListener("click", function () {
                    newTag.remove();
                    let tagIndex = tags.indexOf(newTag.innerText.slice(0, -1));
                    tags.splice(tagIndex, 1);
                    tagsInput.value = tags.join(",");
                });
            } else {
                alert("You can only add up to 5 tags.");
            }
        }
    });
    $(document).on("keydown", "input", function (e) {
        if (e.which == 13) e.preventDefault();
    });

    function preview(id, imgid) {
        let inputid = document.querySelector(`#${id}`).addEventListener("change", function (e) {
            let file = e.target.files[0];
            let imageURL = URL.createObjectURL(file)
            let targetImage = document.getElementById(`${imgid}`)
            targetImage.src = imageURL
        })
    }

    preview("Photo1", "Photo1PreviewPhoto")
</script>

