@model IEnumerable<Baganova.ViewModels.CartVM>

@{
    ViewBag.Title = "Index";
    int session = Convert.ToInt32(Session["userid"]);
    if (session != 0)
    {
        Layout = "~/Views/Shared/_LayoutLogged.cshtml";
    }
    
}


<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option" style="padding: 25px 0">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Shopping Cart</h4>
                    <div class="breadcrumb__links">
                        <a href="./index.html">Home</a>
                        <a href="./shop.html">Shop</a>
                        <span>Shopping Cart</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Shopping Cart Section Begin -->
<section class="shopping-cart spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="shopping__cart__table">
                    <table>
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="product__cart__item">
                                        <div class="product__cart__item__pic">
                                            <img style="height:75px" src="@Html.DisplayFor(modelItem => item.img)" alt="">
                                        </div>
                                        <div class="product__cart__item__text">
                                            <h6>@Html.DisplayFor(modelItem => item.productname)</h6>
                                            <h5>£@Html.DisplayFor(modelItem => item.price)</h5>
                                        </div>
                                    </td>
                                    <td class="quantity__item">
                                        <div class="quantity">
                                            <div class="pro-qty-2" data-cartid="@item.cartid">
                                                <input type="text" value="@item.quantity">
                                            </div>
                                        </div>
                                    </td>
                                    <td class="cart__price">£ @Html.DisplayFor(modelItem => item.total)</td>
                                    <td class="cart__close">
                                        <div style="cursor:pointer" onclick="removefromcart(@Html.DisplayFor(modelItem => item.cartid))">
                                            <i class="fa fa-close"></i>
                                        </div>
                                       
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        <div class="continue__btn">
                            <a href="/">Continue Shopping</a>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-6">
                        @*<div class="continue__btn update__btn">
                                <a href="#"><i class="fa fa-spinner"></i> Update cart</a>
                            </div>*@
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="cart__total">
                    <h6>Cart total</h6>
                    <ul>
                        <li>Subtotal <span>£ @ViewData["subtotal"]</span></li>
                        <li>Delivery changes <span>£ 3.99</span></li>
                        <li>Total <span>£ @ViewData["total"]</span></li>
                    </ul>
                    <button class="primary-btn" onclick="charge()">Proceed to checkout</button>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Shopping Cart Section End -->

@section Scripts {
<script type="text/javascript">
    function removefromcart(cartid) {
        $.ajax({
            type: "POST",
            url: '/carts/removecart?cartid=' + cartid,
            data: param = "",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function () { window.location.reload(); },
            error: function () { }
        });
    }

    function charge() {
        $.ajax({
            type: "POST",
            url: '/carts/charge',
            data: amount = @ViewData["total"],
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) { window.location.href = data.Url; },
            error: function () { }
        });
    }

    function changequantity(opp, cartid) {
        $.ajax({
            type: "POST",
            url: '/carts/changequantity?opp=' + opp + '&cartid=' + cartid,
            data: param = "",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function () { window.location.reload(); },
            error: function () { }
        });
    }
</script>
}