@{
    ViewBag.Title = "FAQs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>FAQs</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <span>FAQs</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<section class="faqs spad">
    <div class="container">
        <div class="shop__sidebar__accordion">
            <div class="accordion" id="accordionExample">
                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">1. Who is Gift Forever Ltd?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#">We are a UK-based gifting brand dedicated to curating elegant, timeless, and meaningful treasures for every occasion. Our collections include luxury hampers, fragrance candles, jewellery, personalised keepsakes, and home décor that add a touch of beauty to life’s special moments.</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">2. How do I place an order?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#">Simply browse our website, add your favourites to the basket, and check out securely. You’ll receive a confirmation email right after placing your order.</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">4. What payment methods do you accept?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#">We accept all major UK debit and credit cards, PayPal,Cheques and other secure payment options.</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">5. How long does delivery take?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#"><strong>UK Standard Delivery:</strong> 7 - 10 working days</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">6. Can I track my order?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#">Yes. Once your order has been dispatched, we’ll send you a tracking link via email or SMS so you can follow your gift’s journey.</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">7. What if my order arrives damaged or incorrect?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#"> We sincerely apologies if this happens! Please contact us within <strong>7 days</strong> of receiving your parcel with your order details and photos, and we’ll arrange a replacement or refund quickly.</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">8. What is your returns policy?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li>
                                        <a href="#">
                                            You may return items within <string>14 days</string> of delivery (excluding personalised/custom gifts).
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#">
                                            Items must be unused and in their original packaging.
                                        </a>
                                    </li>
                                    <li>
                                        <a href="#">
                                            Refunds are processed within <strong>14 working days</strong> after the item reaches us.
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">9. Can I cancel my order?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#"> Yes, if you contact us within <strong>24 hours</strong> of placing the order and it has not been dispatched or personalised.</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">10. How do I contact Gift Forever Ltd?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li><a href="#"> We’d love to hear from you!</a></li>
                                    <li>
                                        <a href="#">
                                            Gift Forever Ltd<br />
                                            📍 41 Sunningdale Road,Crossland Moor,Huddersfield,HD4 5DX <br />
                                            📧 customercare@giftforever.online<br />
                                            📞 +44 2039 871 975<br />
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="card">
                    <div class="card-heading">
                        <a data-toggle="collapse" data-target="#collapseOne" aria-expanded="true">11. Is shopping with you safe?</a>
                    </div>
                    <div id="collapseOne" class="collapse show" data-parent="#accordionExample">
                        <div class="card-body">
                            <div class="shop__sidebar__categories">
                                <ul class="nice-scroll">
                                    <li>
                                        <a href="#">
                                            Absolutely. Our website is fully SSL encrypted, and all payments are processed securely through trusted gateways.
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <br />
        <h3>✨ At Gift Forever Ltd, we believe every gift tells a story – let us help you make yours unforgettable.</h3>
    </div>
</section>

