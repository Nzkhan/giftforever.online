@{
    ViewBag.Title = "Terms & Conditions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .terms-main {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(76,76,255,0.08);
        padding: 2.5rem 2rem;
        margin: 2rem auto;
        max-width: 1100px;
    }
    .terms-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #222;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
        text-align: left;
    }
    .terms-subtitle {
        font-size: 1.1rem;
        color: #888;
        margin-bottom: 2.5rem;
        text-align: left;
        letter-spacing: 0.5px;
    }
    .terms-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 0 2.5rem;
        align-items: flex-start;
    }
    .terms-label {
        font-weight: 700;
        color: #222;
        font-size: 1.1rem;
        margin-bottom: 2.2rem;
        text-align: left;
    }
    .terms-detail {
        color: #444;
        font-size: 1.05rem;
        margin-bottom: 2.2rem;
        line-height: 1.7;
        text-align: left;
    }
    .terms-detail ul {
        margin-left: 1.2rem;
        margin-bottom: 0.5rem;
    }
    @@media (max-width: 900px) {
        .terms-grid {
            grid-template-columns: 1fr;
        }
        .terms-label, .terms-detail {
            margin-bottom: 1.5rem;
        }
    }
</style>

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/home">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Terms & Conditions</strong></div>
        </div>
    </div>
</div>

<section class="terms-main">
    <div class="terms-title">Terms & Conditions</div>
    <div class="terms-subtitle">Please read our terms carefully. The title is on the left, details are shown on the right.</div>
    <div class="terms-grid">
        <div class="terms-label">Company Information</div>
        <div class="terms-detail">This website is operated by Gift Forever Ltd, registered in England & Wales under company number 16227874.<br />Registered office: 41 Sunningdale Road, Crossland Moor, Huddersfield, HD4 5DX<br />Email: customercare@giftforever.online<br />Phone: +44 2039 871 975</div>
        <div class="terms-label">Eligibility</div>
        <div class="terms-detail"><ul><li>You must be at least 18 years old to purchase from our website.</li><li>If you are under 18, you may use the website only under the supervision of a parent/guardian.</li></ul></div>
        <div class="terms-label">Products & Pricing</div>
