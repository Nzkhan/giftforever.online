<div class="site-section mobview">
    <div class="container">
        <div class="title-section mb-5">
            <h2 class="text-uppercase">Videos</h2>
        </div>
        <div class="container" style="margin-top:-40px">
            <div class="row ">
                @{
                    if (video.Count > 0)
                    {
                        foreach (var item in video)
                        {

                            <div class="col-10 col-sm-10 col-md-6  col-lg-4 " stsyle="max-width:100%;margin-bottom:30px">
                                <iframe height="250" width="300" src="@item.VideoLink" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                            </div>

                        }
                    }
                    else
                    {
                        <div>
                            <h2>
                                Data Not Found!
                            </h2>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>


