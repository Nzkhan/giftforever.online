
@{

    if (Session["userid"] != null)
    {
        int session = Convert.ToInt32(Session["userid"]);
        if (session != 0)
        {
            Layout = "~/Views/Shared/_LayoutLogged.cshtml";
        }
    }
    ViewBag.Title = "Video";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var video = ViewBag.Videos;
}

