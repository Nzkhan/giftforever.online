@model Baganova.Models.OrderDetail

@{
    ViewBag.Title = "Order Details";
    int session = Convert.ToInt32(Session["userid"]);
    if (session != 0)
    {
        if (Session["usertype"].ToString() == "Admin")
        {
            Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutLogged.cshtml";
        }

    }
    var order = ViewBag.order;
    var orderdetails = ViewBag.orderDetail;
    var address = ViewBag.address;
    var user = ViewBag.user;

    // compute subtotal from order details to avoid relying on missing model property
    decimal subtotal = 0m;
    if (orderdetails != null)
    {
        foreach (var od in orderdetails)
        {
            try {
                subtotal += Convert.ToDecimal(od.Amount);
            } catch { }
        }
    }
}

<section class="custom-border-bottom py-3" style="background-color: black; color: white;">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"> <a href="/Orders" style="color:white">Orders</a> <span class="mx-2 mb-0">&gt;</span> <span>Details</span></div>
        </div>
    </div>
</section>

<section class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

                <div class="py-3">
                    <div class="d-flex align-items-center mb-3">
                        <h3 class="mb-0" style="font-weight:700">@((Session["usertype"].ToString() == "Admin") ? "Order Details" : "Your Order Details")</h3>
                        <div style="flex:1 1 auto"></div>
                        <a href="/Orders" class="site-btn" style="padding:8px 14px;border-radius:6px;">Back to Orders</a>
                    </div>

                    <div class="order-meta mb-4">
                        <div class="row">
                            <div class="col-sm-3 font-weight-bold">Order ID</div>
                            <div class="col-sm-9">@order.ID</div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-sm-3 font-weight-bold">Order Date</div>
                            <div class="col-sm-9">@order.CreatedOn.ToString("yyyy-MM-dd")</div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-sm-3 font-weight-bold">Shipped to</div>
                            <div class="col-sm-9">@address.address</div>
                        </div>
                    </div>

                    @if (Session["usertype"].ToString() == "Admin")
                    {
                        <div class="order-section mb-4">
                            <div class="font-weight-bold mb-2">Customer Details</div>
                            <div class="row">
                                <div class="col-sm-3 font-weight-bold">Name</div>
                                <div class="col-sm-9">@user.FirstName @user.LastName</div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-3 font-weight-bold">Email</div>
                                <div class="col-sm-9">@user.Email</div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-3 font-weight-bold">Mobile</div>
                                <div class="col-sm-9">@user.Mobile</div>
                            </div>
                        </div>
                    }

                    <div class="order-section">
                        <div class="font-weight-bold mb-2">Order Summary</div>
                        <div class="table-responsive">
                            <table class="table table-borderless mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:100px"></th>
                                        <th>Product</th>
                                        <th style="width:110px">Price</th>
                                        <th style="width:110px">Qty</th>
                                        <th style="width:120px; text-align:right">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in orderdetails)
                                    {
                                        <tr>
                                            <td>
                                                <img loading="lazy" src="./../@item.product.Photo1" alt="" class="order-thumb" />
                                            </td>
                                            <td>
                                                <div class="product-name">@item.product.ProductName</div>
                                            </td>
                                            <td>£@String.Format("{0:0.00}", (item.Amount / (item.Quantity == 0 ? 1 : item.Quantity)))</td>
                                            <td>@item.Quantity</td>
                                            <td style="text-align:right">£@String.Format("{0:0.00}", item.Amount)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <div class="order-totals" style="text-align:right; min-width:220px;">
                                <div class="d-flex justify-content-between"><div>Subtotal</div><div>£@String.Format("{0:0.00}", subtotal)</div></div>
                                <div class="d-flex justify-content-between"><div>Delivery</div><div>£@String.Format("{0:0.00}", order.DeliveryCharges)</div></div>
                                <hr />
                                <div class="d-flex justify-content-between font-weight-bold"><div>Total</div><div>£@String.Format("{0:0.00}", order.TotalAmount)</div></div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <a href="/Orders" class="site-btn" style="padding:8px 14px;border-radius:6px;">Back</a>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

<style>
    /* Minimal flat styling for order details */
    .order-meta .row { padding: 12px 0; border-bottom: 1px solid #eef0f2; }
    .order-section { padding: 12px 0; border-bottom: 1px solid #eef0f2; }
    .order-thumb { width: 84px; height: auto; display:block; }
    .product-name { font-weight:600; }
    @@media (max-width: 576px) {
        .order-totals { min-width: 0; }
    }
</style>
