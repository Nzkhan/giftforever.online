@model IEnumerable<Baganova.Models.Order>

@{
    ViewBag.Title = "My Orders";
    int session = Convert.ToInt32(Session["userid"]);
    bool isAdmin = false;
    if (session != 0)
    {
        if (Session["usertype"] != null && Session["usertype"].ToString() == "Admin")
        {
            Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
            isAdmin = true;
        }
        else
        {
            Layout = "~/Views/Shared/_LayoutLogged.cshtml";
        }

    }
}

<section class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"> 
                @if (isAdmin) {
                    <a href="/Admin" style="color:white">Admin</a> <span class="mx-2 mb-0">&gt;</span>  <span>Orders</span>
                } else {
                    <a href="/home" style="color:white">Home</a> <span class="mx-2 mb-0">&gt;</span>  <span>My Orders</span>
                }
            </div>
        </div>
    </div>
</section>

<section class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="p-4 p-lg-5" style="">
                    <div class="d-flex align-items-center mb-3">
                        <h3 class="mb-0" style="font-weight:700">My Orders</h3>
                        <div style="flex:1 1 auto"></div>
                        <a href="/" class="site-btn" style="padding:8px 14px;border-radius:6px;">Continue Shopping</a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-borderless table-striped my-4">
                            <thead>
                                <tr>
                                    <th style="width:160px;">Date</th>
                                    <th>Status</th>
                                    <th style="width:140px; text-align:right">Total</th>
                                    <th style="width:140px;">&nbsp;</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.CreatedOn.ToString("yyyy-MM-dd")</td>
                                            <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                            <td style="text-align:right">£@String.Format("{0:0.00}", item.TotalAmount)</td>
                                            <td>
                                                @Html.ActionLink("View Details", "Details", "OrderDetails", new { id = item.ID }, new { @class = "btn btn-sm btn-outline-primary" })
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">You have no orders yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
