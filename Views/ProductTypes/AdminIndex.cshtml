@model IEnumerable<Baganova.Models.ProductType>

@{
    ViewBag.Title = "Product Categories";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="custom-border-bottom">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <a href="/Admin">Admin</a> 
                <span class="mx-2">></span>  
                <span>Product Categories</span>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Product Categories</h6>
                    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus-circle me-2"></i> Add Category
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.TypeName)
                                    </th>
                                    <th>Subcategories</th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Description)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.DisplayOrder)
                                    </th>
                                    <th>
                                        Visible
                                    </th>
                                    <th>
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Where(m => m.ParentTypeID == null).OrderBy(m => m.DisplayOrder))
                                {
                                    <tr>
                                        <td>
                                            <strong>@Html.DisplayFor(modelItem => item.TypeName)</strong>
                                        </td>
                                        <td>
                                            @Model.Count(m => m.ParentTypeID == item.ID)
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 50)
                                            {
                                                @item.Description.Substring(0, 50)<text>...</text>
                                            }
                                            else
                                            {
                                                @Html.DisplayFor(modelItem => item.Description)
                                            }
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.DisplayOrder)
                                        </td>
                                        <td>
                                            @if (item.ShowInNavigation)
                                            {
                                                <span class="badge rounded-pill" style="background-color: rgba(3,218,198,0.1); color: var(--secondary-dark);">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill" style="background-color: rgba(0,0,0,0.1); color: rgba(0,0,0,0.6);">No</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex">
                                                <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm me-2" style="color: var(--primary-color);" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("ProductTypePhotos", new { PTid = item.ID })" class="btn btn-sm me-2" style="color: var(--secondary-color);" title="Photos">
                                                    <i class="fas fa-image"></i>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm" style="color: var(--error);" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                    <!-- Show subcategories indented -->
                                    foreach (var subItem in Model.Where(m => m.ParentTypeID == item.ID).OrderBy(m => m.DisplayOrder))
                                    {
                                        <tr style="background-color: rgba(0,0,0,0.01);">
                                            <td>
                                                <div style="padding-left: 20px; display: flex; align-items: center;">
                                                    <i class="fas fa-level-down-alt me-2" style="transform: rotate(90deg); color: rgba(0,0,0,0.3);"></i>
                                                    @Html.DisplayFor(modelItem => subItem.TypeName)
                                                </div>
                                            </td>
                                            <td>
                                                @Model.Count(m => m.ParentTypeID == subItem.ID)
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(subItem.Description) && subItem.Description.Length > 50)
                                                {
                                                    @subItem.Description.Substring(0, 50)<text>...</text>
                                                }
                                                else
                                                {
                                                    @Html.DisplayFor(modelItem => subItem.Description)
                                                }
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => subItem.DisplayOrder)
                                            </td>
                                            <td>
                                                @if (subItem.ShowInNavigation)
                                                {
                                                    <span class="badge rounded-pill" style="background-color: rgba(3,218,198,0.1); color: var(--secondary-dark);">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill" style="background-color: rgba(0,0,0,0.1); color: rgba(0,0,0,0.6);">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex">
                                                    <a href="@Url.Action("Edit", new { id = subItem.ID })" class="btn btn-sm me-2" style="color: var(--primary-color);" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("ProductTypePhotos", new { PTid = subItem.ID })" class="btn btn-sm me-2" style="color: var(--secondary-color);" title="Photos">
                                                        <i class="fas fa-image"></i>
                                                    </a>
                                                    <a href="@Url.Action("Delete", new { id = subItem.ID })" class="btn btn-sm" style="color: var(--error);" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
