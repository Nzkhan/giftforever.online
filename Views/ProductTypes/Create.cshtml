@model Baganova.Models.ProductType

@{
    ViewBag.Title = "Create Category";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<script>
    function previewFileHome() {
        try {
            var preview = document.querySelector('#BrandPhotoPreviewPhoto');
            var file = document.querySelector('#HomePhoto').files[0];
            var reader = new FileReader();

            reader.onloadend = function () {
                preview.src = reader.result;
                preview.style.display = 'block';
            }

            if (file) {
                var extension;
                var dotPosition = file.name.lastIndexOf(".");
                var extension = file.name.substring(dotPosition);
                if (!(extension == ".jpg" || extension == ".jpeg" || extension == ".bmp" || extension == ".png")) {
                    preview.src = "";
                    preview.style.display = 'none';
                    return false;
                }

                if (typeof ($("#HomePhoto")[0].files) != "undefined") {
                    var size = parseFloat($("#HomePhoto")[0].files[0].size / 1024).toFixed(2);

                    if (size >= parseFloat("4096")) {
                        preview.src = "";
                        preview.style.display = 'none';
                        return false;
                    }
                    else {
                        reader.readAsDataURL(file);
                        return true;
                    }
                }
            } else {
                preview.src = "";
                preview.style.display = 'none';
                return false;
            }
        }
        catch (err) {
            console.log(err);
        }
    }

    function previewFileBanner() {
        try {
            var preview = document.querySelector('#FileBannerPreviewPhoto');
            var file = document.querySelector('#TypePhoto').files[0];
            var reader = new FileReader();

            reader.onloadend = function () {
                preview.src = reader.result;
                preview.style.display = 'block';
            }

            if (file) {
                var extension;
                var dotPosition = file.name.lastIndexOf(".");
                var extension = file.name.substring(dotPosition);
                if (!(extension == ".jpg" || extension == ".jpeg" || extension == ".bmp" || extension == ".png")) {
                    preview.src = "";
                    preview.style.display = 'none';
                    return false;
                }

                if (typeof ($("#TypePhoto")[0].files) != "undefined") {
                    var size = parseFloat($("#TypePhoto")[0].files[0].size / 1024).toFixed(2);

                    if (size >= parseFloat("4096")) {
                        preview.src = "";
                        preview.style.display = 'none';
                        return false;
                    }
                    else {
                        reader.readAsDataURL(file);
                        return true;
                    }
                }
            } else {
                preview.src = "";
                preview.style.display = 'none';
                return false;
            }
        }
        catch (err) {
            console.log(err);
        }
    }
</script>

<div class="custom-border-bottom">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <a href="/Admin">Admin</a> 
                <span class="mx-2">></span> 
                <a href="/Producttypes/adminindex">Categories</a> 
                <span class="mx-2">></span> 
                <span>Add Category</span>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Add Product Category</h6>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "ProductTypes", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3", style = "font-size: 0.875rem;" })
                        
                        <div class="form-group mb-3">
                            <label for="TypeName" style="font-size: 0.875rem; color: rgba(0,0,0,0.6);">Category Name <span style="color: var(--error);">*</span></label>
                            @Html.EditorFor(model => model.TypeName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter category name" } })
                            @Html.ValidationMessageFor(model => model.TypeName, "", new { @class = "text-danger", style = "font-size: 0.75rem; display: block; margin-top: 4px;" })
                        </div>

                        <div class="form-group mb-3">
                            <label for="Description" style="font-size: 0.875rem; color: rgba(0,0,0,0.6);">Description</label>
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3", placeholder = "Enter category description" })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger", style = "font-size: 0.75rem; display: block; margin-top: 4px;" })
                        </div>

                        <div class="form-group mb-3">
                            <label for="ParentTypeID" style="font-size: 0.875rem; color: rgba(0,0,0,0.6);">Parent Category</label>
                            @Html.DropDownList("ParentTypeID", ViewBag.ParentTypeID as SelectList, "-- Select Parent Category (Optional) --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ParentTypeID, "", new { @class = "text-danger", style = "font-size: 0.75rem; display: block; margin-top: 4px;" })
                            <small style="font-size: 0.75rem; color: rgba(0,0,0,0.6); display: block; margin-top: 4px;">Select a parent category if this is a subcategory</small>
                        </div>

                        <div class="form-group mb-3">
                            <label for="DisplayOrder" style="font-size: 0.875rem; color: rgba(0,0,0,0.6);">Display Order</label>
                            @Html.EditorFor(model => model.DisplayOrder, new { htmlAttributes = new { @class = "form-control", @Value = "0", placeholder = "Enter display order" } })
                            @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger", style = "font-size: 0.75rem; display: block; margin-top: 4px;" })
                            <small style="font-size: 0.75rem; color: rgba(0,0,0,0.6); display: block; margin-top: 4px;">Controls the order in menus (smaller numbers appear first)</small>
                        </div>

                        <div class="form-group mb-4">
                            <div class="form-check">
                                @Html.EditorFor(model => model.ShowInNavigation, new { htmlAttributes = new { @class = "form-check-input" } })
                                <label for="ShowInNavigation" class="form-check-label" style="font-size: 0.875rem; color: rgba(0,0,0,0.87);">
                                    Show in Navigation
                                </label>
                            </div>
                            <small style="font-size: 0.75rem; color: rgba(0,0,0,0.6); display: block; margin-top: 4px;">Enable to show this category in site navigation menus</small>
                        </div>

                        <div class="form-group mb-3">
                            <label for="HomePhoto" style="font-size: 0.875rem; color: rgba(0,0,0,0.6);">Category Thumbnail</label>
                            <input type="file" id="HomePhoto" name="HomePhoto" class="form-control" onchange="previewFileHome()" aria-label="Category thumbnail">
                            <small style="font-size: 0.75rem; color: rgba(0,0,0,0.6); display: block; margin-top: 4px;">Used for category thumbnails in navigation menus (recommended size: 300x300px)</small>
                            <div class="mt-3">
                                <img loading="lazy" id="BrandPhotoPreviewPhoto" alt="No Image Uploaded" name="BrandPhotoPreviewPhoto" 
                                     style="max-width:100%; max-height:120px; border-radius: 4px; display: none;" />
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="TypePhoto" style="font-size: 0.875rem; color: rgba(0,0,0,0.6);">Category Banner</label>
                            <input type="file" id="TypePhoto" name="TypePhoto" class="form-control" onchange="previewFileBanner()" aria-label="Category banner">
                            <small style="font-size: 0.75rem; color: rgba(0,0,0,0.6); display: block; margin-top: 4px;">Used as the banner at the top of category pages (recommended size: 1200x300px)</small>
                            <div class="mt-3">
                                <img loading="lazy" id="FileBannerPreviewPhoto" alt="No Image Uploaded" name="FileBannerPreviewPhoto" 
                                     style="max-width:100%; border-radius: 4px; display: none;" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a href="@Url.Action("AdminIndex")" class="btn btn-outline-secondary me-2">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i> Save
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
