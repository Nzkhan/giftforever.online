@model Baganova.Models.ProductType

@{
    ViewBag.Title = "Delete product type";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/Admin" style="color:white">Admin</a> <span class="mx-2 mb-0">></span> <a href="/Producttypes/adminindex" style="color:white">Product type</a> <span class="mx-2 mb-0">></span> <span>Delete product type</span></div>
        </div>
    </div>
</div>


<div class="site-section" style="margin-top:-30px">
    <div class="container">
        <div class="row py-4">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="p-3 p-lg-5 shadow" style="border-radius:12px">
                    <p style="font-weight:500;text-align:center;" class="text-black">Are you sure you want to delete this?</p>
                    <div>
                        <hr />
                        <dl class="dl-horizontal">
                            <dt class="text-black">
                                @Html.DisplayNameFor(model => model.TypeName)
                            </dt>

                            <dd >
                                @Html.DisplayFor(model => model.TypeName)
                            </dd>

                            <dt class="text-black">
                                @Html.DisplayNameFor(model => model.Description)
                            </dt>

                            <dd >
                                @Html.DisplayFor(model => model.Description)
                            </dd>

                            <dt class="text-black">
                               @Html.DisplayNameFor(model => model.Photo)
                            </dt>

                            <dd class="text-black">
                                <img loading="lazy" src=".@Html.DisplayFor(model => model.Photo)" style="height:200px; width:100%;object-fit:contain" />
                            </dd>
                            <dt class="text-black">
                                @Html.DisplayNameFor(model => model.HomePhoto)
                            </dt>

                            <dd class="text-black">
                                
                                <img loading="lazy" src=".@Html.DisplayFor(model => model.HomePhoto)" style="height:200px; width:100%;object-fit:contain" />
                            </dd>

                        </dl>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-actions no-color">
                                <input type="submit" value="Delete" class="deleteButton mr-3" />
                                @Html.ActionLink("Back to List", "AdminIndex", null, new { @class = "backtolistbtn" })
                            </div>

                        }
                    </div>
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
</div>