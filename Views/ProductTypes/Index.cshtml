@model IEnumerable<Baganova.Models.ProductType>
@using Baganova.Models

@{
    ViewBag.Title = "Index";
    var db = new PurestContext();
    var type = ViewBag.Type;
    var Products = ViewBag.Products;
    var producttypes = db.ProductTypes.ToList();

    int session = Convert.ToInt32(Session["userid"]);
    if (session != 0)
    {
        Layout = "~/Views/Shared/_LayoutLogged.cshtml";
    }

    //var mapdata = ViewBag.mappingdata;
}

<style>
    /* Local overrides to guarantee readability even if cached CSS is stale */
    .breadcrumb-option--image { position: relative; }
    .breadcrumb-option--image:before { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0)); z-index: 0; }
    .breadcrumb-option--image .breadcrumb__panel { position: relative; z-index: 1; background: rgba(0,0,0,.5); padding: 16px 20px; border-radius: 6px; display: inline-block; }
    .breadcrumb-option--image .breadcrumb__links a,
    .breadcrumb-option--image .breadcrumb__links span,
    .breadcrumb-option--image .breadcrumb__text h4,
    .breadcrumb-option--image .breadcrumb__text h5 { color: #fff !important; text-shadow: 0 2px 6px rgba(0,0,0,.6); }
    .breadcrumb-option--image .breadcrumb__links a:after { color: #fff !important; }

    /* Equal-height product cards like Home -> New Arrivals */
    .product-grid > [class*="col-"] { display: flex; }
    .product__item { display: flex; flex-direction: column; width: 100%; }
    .product__item__pic { height: 260px; background-size: contain !important; background-repeat: no-repeat !important; background-position: center !important; }
    .product__item__text { flex: 1; display: flex; flex-direction: column; }
    .product__item__text h6 { min-height: 48px; line-height: 1.2; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .view-btn { margin-top: auto !important; background-color: #764ba2; color: #fff; padding: 5px 10px; border-radius: 4px; text-align: center; text-decoration: none; font-weight: bold; display: block; }
</style>

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option breadcrumb-option--image" style="background-image:url('@type.Photo'); background-repeat:no-repeat; background-size:cover; background-position:center;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <div class="breadcrumb__panel">
                        <div class="breadcrumb__links">
                                <span>@type.TypeName</span>
                        </div>
                        <h4 style="margin-top:20px"></h4>
                        <div style="margin-top:20px">
                            <h5>@type.Description</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@*<p style="font-size: 1.1em; color: #555; line-height: 1.6; margin-bottom: 20px; text-align: justify;">
    @type.Description
</p>*@
<!-- Breadcrumb Section End -->
<!-- Shop Section Begin -->
<section class="shop spad">
    <div class="container">
        <div class="row">
            
            <div class="col-lg-12">
                <div class="shop__product__option">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__left">
                                <p>Showing results</p>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__right">
                                @*<p>Sort by Price:</p>
                                <select>
                                    <option value="">Low To High</option>
                                    <option value="">$0 - $55</option>
                                    <option value="">$55 - $100</option>
                                </select>*@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row product-grid">

                    @{
                        foreach (var prod in Products)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-6">
                                <div class="product__item">
                                    <div class="product__item__pic set-bg" data-setbg="@prod.Photo1">
                                    </div>
                                    <div class="product__item__text">
                                        <h6>@prod.ProductName</h6>
                                        <a href="#" class="add-cart" onclick="addtocart(@prod.ID)" data-prodid="@prod.ID">+ Add To Cart</a>
                                        <h5>£@prod.Price</h5>
                                    </div>
                                    <a href="/Products/Details?id=@prod.ID" class="view-btn">View</a>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="product__pagination">
                            <a class="active" href="#">1</a>
                            @*<a href="#">2</a>
                            <a href="#">3</a>
                            <span>...</span>
                            <a href="#">21</a>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Price range slider
    $(document).ready(function () {
        // Initialize price display
        const minSlider = document.getElementById('price-min');
        const maxSlider = document.getElementById('price-max');
        const minDisplay = document.getElementById('min-price-display');
        const maxDisplay = document.getElementById('max-price-display');

        minSlider && minSlider.addEventListener('input', function () {
            minDisplay.textContent = this.value;
            if (parseInt(this.value) > parseInt(maxSlider.value)) {
                maxSlider.value = this.value;
                maxDisplay.textContent = this.value;
            }
        });

        maxSlider && maxSlider.addEventListener('input', function () {
            maxDisplay.textContent = this.value;
            if (parseInt(this.value) < parseInt(minSlider.value)) {
                minSlider.value = this.value;
                minDisplay.textContent = this.value;
            }
        });

        // Apply filters button
        $('#apply-filters').click(function () {
            filterProducts();
        });

        function filterProducts() {
            const minPrice = parseInt(minSlider.value);
            const maxPrice = parseInt(maxSlider.value);

            // Get selected fragrances
            const selectedFragrances = [];
            $('input[data-filter-type="fragrance"]:checked').each(function () {
                selectedFragrances.push($(this).val());
            });

            // Get other filter values
            const newOnly = $('input[data-filter-type="new"]:checked').length > 0;
            const bestsellerOnly = $('input[data-filter-type="bestseller"]:checked').length > 0;
            const instockOnly = $('input[data-filter-type="instock"]:checked').length > 0;

            // Filter products
            $('.product-item').each(function () {
                const price = parseFloat($(this).data('price'));
                const fragrance = $(this).data('fragrance');
                const isNew = $(this).data('new') === 'true';
                const isBestseller = $(this).data('bestseller') === 'true';
                const isInStock = $(this).data('instock') === 'true';

                let showProduct = true;

                // Price filter
                if (price < minPrice || price > maxPrice) {
                    showProduct = false;
                }

                // Fragrance filter
                if (selectedFragrances.length > 0 && !selectedFragrances.includes(fragrance)) {
                    showProduct = false;
                }

                // New filter
                if (newOnly && !isNew) {
                    showProduct = false;
                }

                // Bestseller filter
                if (bestsellerOnly && !isBestseller) {
                    showProduct = false;
                }

                // In stock filter
                if (instockOnly && !isInStock) {
                    showProduct = false;
                }

                // Show/hide product
                if (showProduct) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });

            // Show message if no products match filters
            if ($('.product-item:visible').length === 0) {
                if ($('.no-results-message').length === 0) {
                    $('.product-container').append('<div class="col-12 no-results-message"><p class="text-center my-5">No products match your filters. Please try different criteria.</p></div>');
                }
            } else {
                $('.no-results-message').remove();
            }
        }
    });
</script>