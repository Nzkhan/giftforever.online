<script>
    $('select').selectpicker();

    function checked(selectObject) {
        var selected = [];
        for (var option of document.getElementById('ProductMapping').options) {
            if (option.selected) {
                selected.push(option.value);
            }
        }

        select = document.getElementById('ProductMappingValues')
        select.value = selected
    }

    function loadTypesData() {
        debugger
        var categorydata = document.getElementById("ProductMappingValues");
        console.log(categorydata.value);
        var selectedCatList = categorydata.value.split(',');
        @*var dataselection = @pmapping;
        console.log(dataselection);*@

        var catel = document.getElementById('ProductMapping')

        for (var option of catel.options) {
            //console.log(option)
            console.log(option.value)
            for (var selectedid of selectedCatList) {
                if (option.value == selectedid) {
                    console.log("matched");
                    option.selected = true;
                   // option.
                }
            }
            
        }
        catel.onchange();

    }

    console.log(@pmapping)
    
    window.onload = function () {
        loadTypesData();
    };

</script>


