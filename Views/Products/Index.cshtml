@model IEnumerable<Baganova.Models.Product>

@{
    ViewBag.Title = "Index";
    int session = Convert.ToInt32(Session["userid"]);

    if (session != 0)
    {
        Layout = "~/Views/Shared/_LayoutLogged.cshtml";
    }

}

<br />
<br />
<br />

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/home">Admin</a> <span class="mx-2 mb-0">/</span> <strong class="text-black ">Product </strong></div>
        </div>
    </div>
</div>

<br />
<br />

