
@{
    ViewBag.Title = "ProductsPhotos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var prod = ViewBag.products;
}

<div class="bg-light py-3">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/admin">Admin</a> <span class="mx-2 mb-0">/</span> <strong class="text-black ">Product Photos</strong></div>
        </div>
    </div>
</div>

<div class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/Admin" style="color:white">Admin</a> <span class="mx-2 mb-0">></span> <a href="/Products/adminindex" style="color:white">Product type</a> <span class="mx-2 mb-0">></span> <span>Product photo</span></div>
        </div>
    </div>
</div>


