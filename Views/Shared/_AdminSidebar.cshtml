<script>
    function toggleContentMenu(e) {
        e.preventDefault();
        const submenu = document.getElementById('contentSubmenu');
        const link = e.currentTarget;
        const isExpanded = link.getAttribute('aria-expanded') === 'true';
        
        // Toggle submenu visibility and height
        if (isExpanded) {
            submenu.style.maxHeight = '0';
        } else {
            submenu.style.maxHeight = submenu.scrollHeight + 'px';
        }
        
        // Update ARIA attributes
        link.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
        submenu.setAttribute('aria-hidden', isExpanded ? 'true' : 'false');
    }
    
    // Initialize the submenu height if it should be open
    document.addEventListener('DOMContentLoaded', function() {
        const controllers = ['Sliders', 'Testimonial', 'Video'];
        const currentController = '@ViewContext.RouteData.Values["controller"]';
        
        if (controllers.includes(currentController)) {
            const submenu = document.getElementById('contentSubmenu');
            const link = submenu.previousElementSibling;
            
            submenu.style.maxHeight = submenu.scrollHeight + 'px';
            link.setAttribute('aria-expanded', 'true');
            submenu.setAttribute('aria-hidden', 'false');
        }
    });
</script>