@using Baganova.Models;
@{
    // Get notification data
    var db = new PurestContext();
    var lowStockThreshold = 5;
    var lowStockProducts = db.Products.Where(p => p.InStock <= lowStockThreshold && p.InStock > 0).ToList();
    var outOfStockProducts = db.Products.Where(p => p.InStock == 0).ToList();
    var recentOrders = db.Orders.OrderByDescending(o => o.CreatedOn).Take(3).ToList();
    var totalNotifications = lowStockProducts.Count + outOfStockProducts.Count + recentOrders.Count;
    
    // Helper function to determine if a menu item is active
    Func<string, bool> isActive = (string controller) => {
        return ViewContext.RouteData.Values["controller"].ToString().Equals(controller, StringComparison.OrdinalIgnoreCase);
    };
    
    // Special case for dashboard which checks both controller and action
    Func<bool> isDashboardActive = () => {
        return ViewContext.RouteData.Values["controller"].ToString().Equals("Admin", StringComparison.OrdinalIgnoreCase) && 
               ViewContext.RouteData.Values["action"].ToString().Equals("Index", StringComparison.OrdinalIgnoreCase);
    };
    
    // Helper for content submenu items
    Func<bool> isContentActive = () => {
        var controller = ViewContext.RouteData.Values["controller"].ToString();
        return controller.Equals("Sliders", StringComparison.OrdinalIgnoreCase) || 
               controller.Equals("Testimonial", StringComparison.OrdinalIgnoreCase) || 
               controller.Equals("Video", StringComparison.OrdinalIgnoreCase);
    };
}

