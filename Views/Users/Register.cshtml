

<div class="custom-border-bottom py-3" style="">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/home">Home</a> <span class="mx-2 mb-0">/</span> <strong class="text-black">Register</strong></div>
        </div>
    </div>
</div>


<div class="site-section" style="margin-top:62px">
    <div class="container">
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="p-3 p-lg-5 border" style="background: white">

                    <h1 class="text-black">Register User</h1>
                    <hr />
                    <form action="/Users/Register" method="post">

                        <label class="text-black">First Name</label>
                        <input id="FirstName" style="height: 40px !important;" name="FirstName" class="form-control" placeholder="First Name" />
                        <br />

                        <label class="text-black">Last Name</label>
                        <input id="LastName" style="height: 40px !important;" name="LastName" class="form-control" placeholder="Last Name" />
                        <br />

                        <label class="text-black">Landline / Mobile Number</label>
                        <input id="Mobile" style="height: 40px !important;" name="Mobile" class="form-control" placeholder="Mobile" />
                        <br />

                        <label class="text-black">Email</label>
                        <input id="Email" style="height: 40px !important;" name="Email" class="form-control" placeholder="Email" />
                        <br />

                        <hr />
                        <label class="text-black">User Name</label>
                        <input id="username" style="height: 40px !important;" name="username" class="form-control" placeholder="User name" />
                        <br />
                        <label class="text-black">Password</label>
                        <input id="password" name="password" type="password" class="form-control" placeholder="password" />
                        <br />
                        <input type="submit" style="height: 40px !important;" value="Register" class="btn btn-success btn-block" />
                    </form>
                </div>
            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
</div>


