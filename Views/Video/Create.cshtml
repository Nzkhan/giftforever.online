@model Baganova.Models.Video

@{
    ViewBag.Title = "Add Video";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}



<div class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/Admin" style="color:white">Admin</a> <span class="mx-2 mb-0">></span> <a href="/Testimonial/Index" style="color:white">Videos</a> <span class="mx-2 mb-0">></span> <span>Add Video</span></div>
        </div>
    </div>
</div>
<div class="site-section" style="margin-top:-30px">
    <div class="container">
        <div class="row  py-4">
            <div class="col-md-2"></div>
            <div class="col-md-8">
                <div class="p-3 p-lg-5 shadow" style="border-radius:12px">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <p class="text-black" style="font-weight:500;text-align:center;">Add Video</p>

                        <hr />
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.LabelFor(model => model.VideoLink, htmlAttributes: new { @class = "control-label col-md-12 text-black font-weight-bold" })
                            <div class="col-md-12">
                                @Html.EditorFor(model => model.VideoLink, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.VideoLink, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-12">
                                <input type="submit" value="Create" class="createbtn mr-3" />
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "backtolistbtn" })
                            </div>
                        </div>
                    </div>
                    }
                </div>

            </div>
            <div class="col-md-2"></div>
        </div>
    </div>
</div>

