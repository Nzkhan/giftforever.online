@model IEnumerable<Baganova.Models.Video>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}


<div class="custom-border-bottom py-3" style="background-color:black;color:white">
    <div class="container">
        <div class="row">
            <div class="col-md-12 mb-0"><a href="/Admin" style="color:white">Admin</a> <span class="mx-2 mb-0">></span>  <span>Video</span></div>
        </div>
    </div>
</div>

<div class="site-section" style="margin-top:-30px">
    <div class="container">
        <div class="row mb-5 ">
            <form class="col-md-12" method="post">
                <div class="site-blocks-table p-4">

                    <p>
                        @Html.ActionLink("Add New Video", "Create", null, new { @class = "createbtn", @style = "padding-top:10px" })
                    </p>
                    <table class="table table-bordered table-striped my-4">
                        <thead class="thead-dark">
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.VideoLink)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.CreatedDate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.UpdatedDate)
                                </th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model)
                        {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.VideoLink)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CreatedDate)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.UpdatedDate)
                        </td>
                        <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.VideoId }) |
                            @Html.ActionLink("Delete", "Delete", new { id = item.VideoId })
                        </td>
                    </tr>
                        }

                    </table>
                </div>
            </form>
        </div>

    </div>
</div>
