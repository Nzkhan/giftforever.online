@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="mb-2">Dashboard</h4>
            <p class="text-muted" style="font-size: 0.875rem;">Welcome to Gift Forever Admin Panel. Manage your products, orders, and content from here.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-4 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="stats-title">Orders</div>
                <div class="stats-value">75</div>
                <div class="mt-3">
                    <a href="/Orders" class="btn btn-sm btn-outline-primary">View Orders</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon" style="background-color: rgba(3, 218, 198, 0.08); color: var(--secondary-color);">
                    <i class="fas fa-box-open"></i>
                </div>
                <div class="stats-title">Products</div>
                <div class="stats-value">101</div>
                <div class="mt-3">
                    <a href="/Products/adminindex" class="btn btn-sm btn-outline-secondary">Manage Products</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-3">
            <div class="stats-card">
                <div class="stats-icon" style="background-color: rgba(187, 134, 252, 0.08); color: var(--primary-light);">
                    <i class="fas fa-tags"></i>
                </div>
                <div class="stats-title">Categories</div>
                <div class="stats-value">8</div>
                <div class="mt-3">
                    <a href="/ProductTypes/adminindex" class="btn btn-sm btn-outline-primary">Manage Categories</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Quick Actions</h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a href="/Products/Create" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4">
                            <i class="fas fa-plus-circle me-3" style="color: var(--secondary-color);"></i>
                            <span>Add New Product</span>
                        </a>
                        <a href="/ProductTypes/Create" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4">
                            <i class="fas fa-folder-plus me-3" style="color: var(--primary-color);"></i>
                            <span>Create New Category</span>
                        </a>
                        <a href="/Sliders/Create" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4">
                            <i class="fas fa-images me-3" style="color: var(--primary-light);"></i>
                            <span>Add New Slider</span>
                        </a>
                        <a href="/Testimonial/Create" class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4">
                            <i class="fas fa-quote-right me-3" style="color: var(--secondary-dark);"></i>
                            <span>Add New Testimonial</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">System Information</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-server me-3" style="color: rgba(0,0,0,0.54);"></i> Application Version</span>
                            <span class="badge rounded-pill" style="background-color: rgba(0,0,0,0.1); color: rgba(0,0,0,0.6);">1.0.0</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-database me-3" style="color: rgba(0,0,0,0.54);"></i> Database</span>
                            <span class="badge rounded-pill" style="background-color: rgba(3,218,198,0.1); color: var(--secondary-dark);">Connected</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-hdd me-3" style="color: rgba(0,0,0,0.54);"></i> Storage</span>
                            <span class="badge rounded-pill" style="background-color: rgba(187,134,252,0.1); color: var(--primary-dark);">85% Free</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span><i class="fas fa-lock me-3" style="color: rgba(0,0,0,0.54);"></i> Security Status</span>
                            <span class="badge rounded-pill" style="background-color: rgba(3,218,198,0.1); color: var(--secondary-dark);">Secure</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>